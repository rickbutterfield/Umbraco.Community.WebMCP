{
	"$schema": "../../../umbraco-package-schema.json",
	"name": "WebMCP Forms example",
	"version": "0.1.0",
	"allowTelemetry": false,
	"extensions": [
		{
			"type": "webMcpWorkspaceToolset",
			"alias": "WebMcpFormsExample.WorkspaceToolset.Form",
			"name": "WebMCP Forms example: form designer tools",
			"api": "/App_Plugins/WebMcpFormsExample/form.webmcp-toolset.js",
			"conditions": [{ "alias": "Umb.Condition.WorkspaceAlias", "match": "Forms.Workspace.Form" }]
		}
	]
}
