{
  "name": "umbraco-webmcp-benchmarks",
  "private": true,
  "description": "Benchmarks Playwright through the UI against Playwright with the page API, and agents with and without it",
  "type": "module",
  "scripts": {
    "setup": "playwright test --project=setup",
    "scripted": "playwright test --project=scripted --repeat-each=10",
    "agent": "node agent/run.mjs",
    "summarise": "node summarise.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20.19.43",
    "@umbraco-cms/acceptance-test-helpers": "18.2.1",
    "dotenv": "^16.3.1"
  }
}
